{
  "name": "tendr-ai",
  "compatibility_date": "2026-11-09",
  "main": "worker/index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "NEN_RATE_LIMIT", "namespace_id": "260091", "simple": { "limit": 2, "period": 60 } }
  ],
  "build": {
    "command": "pnpm build"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./apps/web/dist",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
