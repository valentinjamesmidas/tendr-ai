{
  "name": "tendr-ai",
  "compatibility_date": "2026-11-09",
  "main": "worker/index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "ai": { "binding": "AI" },
  "vars": {
    "NEN_PUBLIC_INDEX": "enabled",
    "NEN_PROFILE_SOURCES": "mmr"
  },
  "ratelimits": [
    { "name": "NEN_RATE_LIMIT", "namespace_id": "260091", "simple": { "limit": 2, "period": 60 } },
    { "name": "CUSTOMER_RATE_LIMIT", "namespace_id": "260092", "simple": { "limit": 8, "period": 60 } }
  ],
  "d1_databases": [
    { "binding": "CUSTOMERS", "database_name": "tendr-ai-customers", "database_id": "faa23db5-de14-4787-976c-205ff543e484" }
  ],
  "build": {
    "command": "pnpm build"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./apps/web/dist",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
